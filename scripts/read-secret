#!/usr/bin/env bash
## Print one decrypted secret from DivitMittal/infra-nixCfg-secrets to stdout,
## for Terragrunt to pass to a provider through the environment.
##
##   read-secret cloud/cloudflare/api_token.age
##
## Reads the committed file from the secrets repo's default branch with
## `git show`, so it works whatever branch that checkout is on, and never
## writes plaintext to disk.
##   QEZTA_SECRETS_REPO  checkout path (default ~/Projects/Cfgs/infra-nixCfg-secrets)
##   QEZTA_SECRETS_REF   ref to read (default origin/master)
##   AGE_IDENTITY        age identity (default ~/.ssh/agenix/id_ed25519)
set -euo pipefail

name="${1:?usage: read-secret <path relative to secrets/>}"
case "$name" in
  /* | *..* | *[!a-zA-Z0-9_./-]*) echo "read-secret: invalid secret path: $name" >&2; exit 64 ;;
esac

repo="${QEZTA_SECRETS_REPO:-$HOME/Projects/Cfgs/infra-nixCfg-secrets}"
ref="${QEZTA_SECRETS_REF:-origin/master}"
identity="${AGE_IDENTITY:-$HOME/.ssh/agenix/id_ed25519}"

[ -d "$repo/.git" ] || [ -f "$repo/.git" ] || { echo "read-secret: no secrets checkout at $repo (set QEZTA_SECRETS_REPO)" >&2; exit 66; }
git -C "$repo" cat-file -e "$ref:secrets/$name" 2>/dev/null || { echo "read-secret: $ref:secrets/$name not found (git -C $repo fetch?)" >&2; exit 66; }
git -C "$repo" show "$ref:secrets/$name" | age -d -i "$identity"
